<Window x:Class="Perihelion.Views.PerihelionFramingComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Perihelion.ViewModels"
        Title="Perihelion Framing Composer"
        Width="980" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <!--
      A real popup Window, not a merged DataTemplate like this project's other Windows-only
      views — it needs its own code-behind (Confirm/Cancel closing the dialog) that a plain
      DataTemplate has no way to provide. Runs inside the same WPF Application as real NINA
      itself, so it automatically inherits NINA's own app-wide implicit styles (Button, TextBlock,
      etc.) from Application.Current.Resources with no merging of its own needed — only the
      Window's own Background needs to be set explicitly, since a plain Window defaults to a
      system/white background otherwise. Same Button-Foreground fix as PerihelionDockableView.xaml
      applies here for the same reason (NINA's own global implicit TextBlock style otherwise wins
      over a Button's intended Foreground) — see that file's own comment for the full mechanism.

      Real sky map (left column), not NINA's own Framing Assistant tab and not a custom-drawn
      abstraction — genuine sky-survey imagery fetched via NINA.WPF.Base.SkySurvey (same
      plugin-safe assembly AltitudeChart already came from), with an FOV rectangle sized from the
      user's own real camera/telescope profile settings. See PerihelionFramingComposerVM's own
      LoadSkyMapAsync doc comment for exactly how.
    -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        </Style>
    </Window.Resources>
    <!-- ScrollViewer + Window's own MaxHeight (above), real user feedback (2026-09-05): on a
         shorter screen this window's content was taller than the visible area with no way to
         reach the rest of it — SizeToContent="Height" alone has no notion of "too tall for this
         screen". With MaxHeight set, WPF sizes the window to its content up to that cap and this
         ScrollViewer handles whatever doesn't fit beyond it, rather than silently clipping it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Sky map + FOV rectangle. -->
        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Image Source" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding ImageSources}" SelectedItem="{Binding SelectedImageSource}" />
            </Grid>
            <!-- Fixed size matching PerihelionFramingComposerVM.SkyMapDisplaySize exactly — both
                 need to agree since the VM's own pixelsPerArcmin/FovRectWidth/Height are computed
                 in that same fixed coordinate space.
                 ONE drag interaction (2026-09-05, corrected after reading Touch-N-Stars' own
                 FramingOffsetView.vue directly, not guessed a second time): dragging anywhere on
                 the sky map pans the whole view (SkyMap_*, code-behind, sets ImagePanX/Y) —
                 real, not cosmetic: ImagePanX/Y's own setters on the VM derive and set the real
                 offset from the pan distance. The target marker lives INSIDE the same transformed
                 Grid as the Image (not a fixed overlay), so it moves together with the sky map
                 when panned, the same way a pin stays attached to a map's own terrain rather than
                 the viewport — exactly TNS's own behavior. The FOV rectangle is the opposite: it
                 stays fixed at the viewport's own center always (HorizontalAlignment/
                 VerticalAlignment=Center, no Canvas position at all), same as TNS's own FOV
                 overlay — there is no independently-draggable FOV box. -->
            <Border Width="600" Height="600" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="Black" VerticalAlignment="Top" ClipToBounds="True"
                    MouseWheel="SkyMap_MouseWheel" MouseLeftButtonDown="SkyMap_MouseLeftButtonDown"
                    MouseMove="SkyMap_MouseMove" MouseLeftButtonUp="SkyMap_MouseLeftButtonUp">
                <Grid>
                    <!-- Image + marker share this one Grid's RenderTransform, so they pan/zoom
                         as a single unit. -->
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                <TranslateTransform X="{Binding ImagePanX}" Y="{Binding ImagePanY}" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image Source="{Binding SkyImage}" Stretch="UniformToFill" />
                        <!-- Target marker — a real dot/circle, fixed at the exact center of the
                             untransformed image (dead center of the Border above, whatever its
                             own current size is). The target itself
                             is always centered in the requested sky map image by construction
                             (LoadSkyMapAsync requests it centered on trueCoordinates), so this
                             never needs to be computed or bound — only the shared transform
                             above ever moves it. Sized relative to the FOV rectangle (via
                             TargetMarkerSize), not a fixed pixel size — see that property's own
                             doc comment for why. -->
                        <Ellipse Width="{Binding TargetMarkerSize}" Height="{Binding TargetMarkerSize}"
                                 Fill="{DynamicResource ButtonBackgroundSelectedBrush}"
                                 Stroke="White" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <!-- FOV rectangle — always screen-centered (never part of the pan/zoom
                         TranslateTransform above, matching TNS's own fixed FOV overlay), but it
                         DOES need its own ScaleTransform tied to ImageZoom: FovRectWidth/Height
                         are computed once from the image's real FoVWidth at zoom=1, so as the
                         background is scaled up/down to show more/less real sky, the box
                         representing the camera's fixed angular FOV against that same background
                         has to scale by the same factor to stay physically accurate — real user
                         feedback (2026-09-05): zoom worked but the FOV box stayed a fixed pixel
                         size regardless. -->
                    <Rectangle Width="{Binding FovRectWidth}" Height="{Binding FovRectHeight}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                               IsHitTestVisible="False"
                               Stroke="{DynamicResource ButtonForegroundBrush}" StrokeThickness="0.6"
                               StrokeDashArray="1.6,2.2" StrokeDashCap="Round">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                <RotateTransform Angle="{Binding DisplayRotationAngle}" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="{Binding SkyMapStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" Opacity="0.85" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <TextBlock Text="Scroll to zoom, drag to pan and reframe -- the marker is the real target position, the dashed box is your camera's FOV." TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="{Binding TargetName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PositionText}" Opacity="0.8" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Rotator" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <!-- BasedOn is required here — same real bug already caught once in this
                             project's main panel Button style: a bare inline Style with no
                             BasedOn completely REPLACES NINA's own app-wide implicit TextBlock
                             style (which sets Foreground to PrimaryBrush) rather than adding to
                             it, so this TextBlock fell back to WPF's true framework default
                             (plain black) instead — confirmed as the real cause of the black
                             text in a real screenshot. -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="Not connected" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RotatorConnected}" Value="True">
                                    <Setter Property="Text" Value="Connected" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <!-- No longer gated on RotatorConnected (real user feedback, 2026-09-05: "if the user
                 has no rotator then it doesn't matter, they don't have to use it, and Determine
                 Rotation from Camera will tell them their framing view anyway rotation-wise") —
                 toggling this on without a rotator is harmless: SlewButtonLabel/SlewAndCenterAction
                 both check RotatorConnected too, not just UseRotation, so without one, Slew and
                 Center transparently falls back to plain centering (no CenterAndRotate attempted
                 against hardware that isn't there) while RotationAngle still drives the FOV
                 rectangle's own on-screen preview for reference. -->
            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Rotate to" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding UseRotation}" />
                </StackPanel>
                <!-- A real slider, not just a typed number — matches Touch-N-Stars' own
                     rotation control (FramingOffsetView.vue's <input type="range" min="0"
                     max="360">) exactly, since the FOV rectangle's own on-screen rotation gives
                     immediate visual feedback as you drag it, which a bare TextBox doesn't.
                     Rebuilt (2026-09-05, real user feedback "looks awful") to match real NINA's
                     OWN proven rotation Slider usage exactly — NINA/View/FramingAssistantView.xaml
                     puts its own rotation Slider in a Grid's star-sized column (so it stretches to
                     fill, rather than a fixed pixel Width inside a StackPanel, which is what this
                     control used before) and sets IsSnapToTickEnabled/TickFrequency for real tick
                     marks — copying that layout instead of guessing a second time. -->
                <Grid IsEnabled="{Binding UseRotation}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="359.99"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            Value="{Binding RotationAngle, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding RotationAngle, StringFormat='{}{0:F0}°'}"
                               VerticalAlignment="Center" Width="40" Opacity="0.85" />
                </Grid>
            </StackPanel>

            <!-- Real plate-solve rotation readout — works with or without a rotator connected;
                 see PerihelionFramingComposerVM.DetermineRotationAction's own doc comment for the
                 full reasoning and the real NINA source this was ported from. -->
            <Button Command="{Binding DetermineRotationCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                    ToolTip="Captures a frame right now and plate-solves it to read the camera's real current rotation -- works with or without a rotator; if a rotator IS connected, it's also synced to the measured value.">
                <TextBlock Text="Determine Rotation from Camera" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
            </Button>

            <!-- Slew and Center (label itself reflects the Slew options popup's own Center/Rotate
                 toggles — see SlewButtonLabel's own doc comment) plus its settings cog. -->
            <Grid Margin="0,0,0,8" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding SlewAndCenterCommand}"
                        ToolTip="Runs a real slew (and plate-solve center / rotate, depending on the cog's own options) against the mount right now -- the same NINA sequence items Add to Sequence itself uses.">
                    <TextBlock Text="{Binding SlewButtonLabel}" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Grid.Column="2" Name="SlewOptionsCogButton" Command="{Binding ToggleSlewOptionsCommand}"
                        Width="30" Padding="0" ToolTip="Slew options -- choose Slew, Slew &amp; Center, or Slew, Center &amp; Rotate.">
                    <TextBlock Text="&#9881;" FontSize="15" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Popup PlacementTarget="{Binding ElementName=SlewOptionsCogButton}" Placement="Bottom"
                       IsOpen="{Binding SlewOptionsOpen}" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="12" Margin="0,4,0,0">
                        <StackPanel Width="210">
                            <TextBlock Text="Slew Options" FontWeight="Bold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding IncludeCenter}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Center (plate-solve)" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding UseRotation}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Rotate" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Always available -- forces Center on too. Without a rotator connected, Slew and Center falls back to plain centering (no rotate command sent); the angle still previews on the FOV box for reference."
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,16" />

            <Separator Margin="0,0,0,12" />

            <TextBlock Text="Nudge the mount by hand now if you want to frame off-center (e.g. a comet's tail), then capture that as an offset."
                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Offset RA" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="{Binding OffsetRaText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="Offset Dec" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="3" Text="{Binding OffsetDecText}" VerticalAlignment="Center" />
            </Grid>
            <Button Command="{Binding CaptureOffsetCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                <TextBlock Text="Capture Offset from Mount" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
            </Button>

            <Separator Margin="0,0,0,12" />

            <TextBlock Text="Use This Framing sets the offset (and rotation, if used) in the plugin, for Add to Sequence and Quick Track to pick up -- it doesn't slew or start anything by itself."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,4" />
            <!-- Reset's own confirmation lands here, not in the shared StatusText TextBlock up
                 near Slew and Center — real user feedback (2026-09-05): that text showed up in
                 the wrong place, under Slew and Center, when Reset is really a bottom-row action.
                 Empty (and so invisible — TextBlock collapses to zero height with no text) until
                 Reset is actually clicked. -->
            <TextBlock Text="{Binding FooterStatusText}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Name="ConfirmButton" Click="ConfirmButton_Click" Margin="0,0,8,0"
                        ToolTip="Uses whatever offset and rotation are captured above for Add to Sequence and Quick Track.">
                    <TextBlock Text="Use This Framing" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Command="{Binding ResetCommand}" Margin="0,0,8,0"
                        ToolTip="Clears pan/zoom, rotation, and offset back to how this window opened -- doesn't close it.">
                    <TextBlock Text="Reset" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Name="CancelButton" Click="CancelButton_Click">
                    <TextBlock Text="Cancel" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
