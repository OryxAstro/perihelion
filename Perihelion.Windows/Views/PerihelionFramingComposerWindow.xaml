<Window x:Class="Perihelion.Views.PerihelionFramingComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Perihelion.ViewModels"
        xmlns:conv="clr-namespace:Perihelion.Converters"
        Title="Perihelion Framing Composer"
        Width="980" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <!--
      A popup Window, not a merged DataTemplate like this project's other Windows-only
      views — it needs its own code-behind (Confirm/Cancel closing the dialog) that a plain
      DataTemplate has no way to provide. Runs inside the same WPF Application as NINA
      itself, so it automatically inherits NINA's own app-wide implicit styles from
      Application.Current.Resources — only the Window's own Background needs to be set
      explicitly. Same Button-Foreground fix as PerihelionDockableView.xaml applies here for the
      same reason — see that file's own comment for the full mechanism.

      Sky map (left column), not NINA's own Framing Assistant tab and not a custom-drawn
      abstraction — genuine sky-survey imagery fetched via NINA.WPF.Base.SkySurvey, with an FOV
      rectangle sized from the user's own camera/telescope profile settings. See
      PerihelionFramingComposerVM's own LoadSkyMapAsync doc comment for exactly how.
    -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        </Style>
        <conv:TargetLabelLeftConverter x:Key="TargetLabelLeftConverter" />
    </Window.Resources>
    <!-- ScrollViewer + Window's own MaxHeight (above): SizeToContent="Height" alone has no
         notion of "too tall for this screen", so on a shorter display this window's content
         could exceed the visible area with no way to reach the rest of it. With MaxHeight set,
         WPF sizes the window to its content up to that cap and this ScrollViewer handles
         whatever doesn't fit beyond it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Sky map + FOV rectangle. -->
        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Image Source" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding ImageSources}" SelectedItem="{Binding SelectedImageSource}" />
            </Grid>
            <!-- Fixed size matching PerihelionFramingComposerVM.SkyMapDisplaySize exactly — both
                 need to agree since the VM's own pixelsPerArcmin/FovRectWidth/Height are computed
                 in that same fixed coordinate space.
                 ONE drag interaction, matching Touch-N-Stars' own FramingOffsetView.vue: dragging
                 anywhere on the sky map pans the whole view (SkyMap_*, code-behind, sets
                 ImagePanX/Y) —, not cosmetic: ImagePanX/Y's own setters on the VM derive and
                 set the offset from the pan distance. The target marker lives INSIDE the
                 same transformed Grid as the Image (not a fixed overlay), so it moves together
                 with the sky map when panned, like a pin attached to a map's own terrain rather
                 than the viewport. The FOV rectangle is the opposite: it stays fixed at the
                 viewport's own center always, with no independently-draggable FOV box. -->
            <Border Width="600" Height="600" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="Black" VerticalAlignment="Top" ClipToBounds="True"
                    MouseWheel="SkyMap_MouseWheel" MouseLeftButtonDown="SkyMap_MouseLeftButtonDown"
                    MouseMove="SkyMap_MouseMove" MouseLeftButtonUp="SkyMap_MouseLeftButtonUp">
                <Grid>
                    <!-- Image + marker share this one Grid's RenderTransform, so they pan/zoom
                         as a single unit. -->
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                <TranslateTransform X="{Binding ImagePanX}" Y="{Binding ImagePanY}" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image Source="{Binding SkyImage}" Stretch="UniformToFill" />
                        <!-- 10-night path overlay, matching Touch-N-Stars' own
                             FramingOffsetView.vue (a violet path line plus dots). Lives in this
                             SAME transformed Grid (not the FOV rectangle's viewport-fixed one
                             below) since these are positions on the sky that should pan/zoom
                             along with the image and target marker — see PathPolylinePoints/
                             PathMarkers' own doc comment on the projection math and why day 0
                             isn't drawn as its own separate dot. Solid, thin, slightly
                             translucent, matching FramingOffsetView.vue's own canvas-drawn
                             values. -->
                        <Polyline Points="{Binding PathPolylinePoints}" Stroke="#A78BFA" StrokeThickness="1.2"
                                  Opacity="0.85" IsHitTestVisible="False" />
                        <ItemsControl ItemsSource="{Binding PathMarkers}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="3.5" Height="3.5" Fill="#A78BFA" ToolTip="{Binding Tooltip}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-1.75" Y="-1.75" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <!-- Target marker — a dot/circle, fixed at the exact center of the
                             untransformed image. The target itself is always centered in the
                             requested sky map image by construction (LoadSkyMapAsync requests it
                             centered on trueCoordinates), so this never needs to be computed or
                             bound — only the shared transform above ever moves it. Sized relative
                             to the FOV rectangle (via TargetMarkerSize), not a fixed pixel size —
                             see that property's own doc comment for why. -->
                        <Ellipse Width="{Binding TargetMarkerSize}" Height="{Binding TargetMarkerSize}"
                                 Fill="{DynamicResource ButtonBackgroundSelectedBrush}"
                                 Stroke="White" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <!-- Target name, matching FramingOffsetView.vue's own name-tag placement:
                         sits on the OPPOSITE side from wherever the path continues from the
                         marker (see TargetLabelOnRight's own doc comment), so it never runs
                         alongside/through the path line. Lives in this OUTER, untransformed Grid
                         (not the image/marker/path's own transformed one above) and computes its
                         own screen position directly from ImagePanX/Y — see TargetLabelScreenX/Y's
                         own doc comment for why dropping ImageZoom from the position is exact.
                         Canvas.Left needs the label's own rendered width (WPF has no SVG-style
                         text-anchor), hence the MultiBinding pulling in ActualWidth via a
                         self-reference rather than something precomputed in the VM. -->
                    <Canvas IsHitTestVisible="False">
                        <TextBlock Text="{Binding TargetName}" Foreground="White" FontSize="11"
                                   Canvas.Top="{Binding TargetLabelScreenY}">
                            <Canvas.Left>
                                <MultiBinding Converter="{StaticResource TargetLabelLeftConverter}">
                                    <Binding Path="TargetLabelScreenX" />
                                    <Binding Path="TargetLabelOnRight" />
                                    <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                                    <Binding Path="TargetLabelGap" />
                                </MultiBinding>
                            </Canvas.Left>
                        </TextBlock>
                    </Canvas>
                    <!-- FOV rectangle — always screen-centered (never part of the pan/zoom
                         TranslateTransform above, matching Touch-N-Stars' own fixed FOV overlay),
                         but it DOES need its own ScaleTransform tied to ImageZoom: FovRectWidth/
                         Height are computed once from the image's FoVWidth at zoom=1, so as
                         the background is scaled up/down to show more/less sky, the box
                         representing the camera's fixed angular FOV against that same background
                         has to scale by the same factor to stay physically accurate. -->
                    <Rectangle Width="{Binding FovRectWidth}" Height="{Binding FovRectHeight}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                               IsHitTestVisible="False"
                               Stroke="{DynamicResource ButtonForegroundBrush}" StrokeThickness="0.6"
                               StrokeDashArray="1.6,2.2" StrokeDashCap="Round">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                <RotateTransform Angle="{Binding DisplayRotationAngle}" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="{Binding SkyMapStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" Opacity="0.85" IsHitTestVisible="False" />

                    <!-- Legend + live center readout — viewport-fixed overlays (siblings of the
                         FOV rectangle, not inside the panned/zoomed Grid), matching Touch-N-Stars'
                         own FramingOffsetView.vue top-left/top-right pill overlays. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8" IsHitTestVisible="False">
                        <Border Background="#80000000" CornerRadius="3" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pan to frame" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="#A78BFA" Margin="10,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Path" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ButtonBackgroundSelectedBrush}" Margin="10,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tonight" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Background="#80000000" CornerRadius="3" Padding="6,3"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsHitTestVisible="False">
                        <TextBlock Text="{Binding CurrentCenterText}" FontSize="10" Foreground="#CCFFFFFF" />
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="Scroll to zoom, drag to pan and reframe -- the marker is the target position, the dashed box is your camera's FOV." TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="{Binding TargetName}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PositionText}" Opacity="0.8" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Rotator" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <!-- BasedOn is required — a bare inline Style with no BasedOn completely
                             REPLACES NINA's own app-wide implicit TextBlock style (which sets
                             Foreground to PrimaryBrush) rather than adding to it, so this
                             TextBlock would otherwise fall back to WPF's true framework default
                             (plain black). -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="Not connected" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RotatorConnected}" Value="True">
                                    <Setter Property="Text" Value="Connected" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <!-- Not gated on RotatorConnected — toggling this on without a rotator is harmless:
                 SlewButtonLabel/SlewAndCenterAction both check RotatorConnected too, not just
                 UseRotation, so without one, Slew and Center transparently falls back to plain
                 centering (no CenterAndRotate attempted against hardware that isn't there) while
                 RotationAngle still drives the FOV rectangle's own on-screen preview for
                 reference. -->
            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Rotate to" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding UseRotation}" />
                </StackPanel>
                <!-- A slider, not just a typed number — matches Touch-N-Stars' own rotation
                     control (FramingOffsetView.vue's <input type="range">) and NINA's own
                     proven rotation Slider usage (NINA/View/FramingAssistantView.xaml): a Grid's
                     star-sized column so it stretches to fill, plus IsSnapToTickEnabled/
                     TickFrequency for tick marks. -->
                <Grid IsEnabled="{Binding UseRotation}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="359.99"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            Value="{Binding RotationAngle, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding RotationAngle, StringFormat='{}{0:F0}°'}"
                               VerticalAlignment="Center" Width="40" Opacity="0.85" />
                </Grid>
            </StackPanel>

            <!-- Plate-solve rotation readout — works with or without a rotator connected;
                 see PerihelionFramingComposerVM.DetermineRotationAction's own doc comment for the
                 full reasoning and the NINA source this was ported from. -->
            <Button Command="{Binding DetermineRotationCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                    ToolTip="Captures a frame right now and plate-solves it to read the camera's current rotation -- works with or without a rotator; if a rotator IS connected, it's also synced to the measured value.">
                <TextBlock Text="Determine Rotation from Camera" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
            </Button>

            <!-- Slew and Center (label itself reflects the Slew options popup's own Center/Rotate
                 toggles — see SlewButtonLabel's own doc comment) plus its settings cog. -->
            <Grid Margin="0,0,0,8" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding SlewAndCenterCommand}"
                        ToolTip="Runs a slew (and plate-solve center / rotate, depending on the cog's own options) against the mount right now -- the same NINA sequence items Add to Sequence itself uses.">
                    <TextBlock Text="{Binding SlewButtonLabel}" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Grid.Column="2" Name="SlewOptionsCogButton" Command="{Binding ToggleSlewOptionsCommand}"
                        Width="30" Padding="0" ToolTip="Slew options -- choose Slew, Slew &amp; Center, or Slew, Center &amp; Rotate.">
                    <TextBlock Text="&#9881;" FontSize="15" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Popup PlacementTarget="{Binding ElementName=SlewOptionsCogButton}" Placement="Bottom"
                       IsOpen="{Binding SlewOptionsOpen}" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="12" Margin="0,4,0,0">
                        <StackPanel Width="210">
                            <TextBlock Text="Slew Options" FontWeight="Bold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding IncludeCenter}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Center (plate-solve)" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding UseRotation}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Rotate" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Always available -- forces Center on too. Without a rotator connected, Slew and Center falls back to plain centering (no rotate command sent); the angle still previews on the FOV box for reference."
                                       TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,16" />

            <Separator Margin="0,0,0,12" />

            <TextBlock Text="Drag the sky map to frame off-center (e.g. a comet's tail) — the offset below updates live."
                       TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Offset RA" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="{Binding OffsetRaText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="Offset Dec" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="3" Text="{Binding OffsetDecText}" VerticalAlignment="Center" />
            </Grid>

            <Separator Margin="0,0,0,12" />

            <TextBlock Text="Use This Framing sets the offset (and rotation, if used) in the plugin, for Add to Sequence and Quick Track to pick up -- it doesn't slew or start anything by itself."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,4" />
            <!-- Reset's own confirmation lands here, not in the shared StatusText TextBlock up
                 near Slew and Center, since Reset is really a bottom-row action, not something
                 Slew and Center reports on. Empty (and so invisible) until Reset is clicked. -->
            <TextBlock Text="{Binding FooterStatusText}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Name="ConfirmButton" Click="ConfirmButton_Click" Margin="0,0,8,0"
                        ToolTip="Uses whatever offset and rotation are captured above for Add to Sequence and Quick Track.">
                    <TextBlock Text="Use This Framing" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Command="{Binding ResetCommand}" Margin="0,0,8,0"
                        ToolTip="Clears pan/zoom, rotation, and offset back to how this window opened -- doesn't close it.">
                    <TextBlock Text="Reset" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Name="CancelButton" Click="CancelButton_Click">
                    <TextBlock Text="Cancel" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
