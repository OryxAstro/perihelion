<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Perihelion.ViewModels">

    <!--
      Perihelion's native dockable panel content — an implicit DataTemplate (no x:Key) keyed by
      DataType, the standard WPF mechanism NINA's own imaging-tab dock host uses to resolve a
      ContentPresenter's content for a given IDockableVM instance. Merged into
      Application.Current.Resources.MergedDictionaries from PerihelionPlugin's own constructor,
      the same proven mechanism already used for PerihelionOptionsView.xaml — see that file's
      own comment, and PerihelionPlugin.RegisterWindowsResources, for why.
    -->
    <DataTemplate DataType="{x:Type local:PerihelionDockableVM}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- Browse -->
                <TextBlock Text="Browse" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Width="90" ItemsSource="{Binding ObjectTypes}" SelectedItem="{Binding SelectedObjectType}" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshBrowseListCommand}" Padding="8,2" />
                </Grid>
                <!-- ListView, not ListBox: NINA's own theme only re-styles ListView/ListViewItem
                     globally, not plain ListBox/ListBoxItem (confirmed from a real resource
                     dump in this app's own log, then from NINA's actual source —
                     NINA.WPF.Base/Resources/Styles/ListView.xaml). That same source is why a
                     plain ItemTemplate rendered nothing at all after the background fix: NINA's
                     global ListViewItem style hardcodes its content as a bare
                     GridViewRowPresenter with no Columns of its own — it only draws anything
                     once ListView.View is an actual GridView, whose GridView.ColumnCollection
                     feeds those columns. A real GridView here (not a custom ItemTemplate) is
                     what NINA's own theme actually expects, and its column cells use the app's
                     normal default TextBlock style automatically, same as any other page text. -->
                <ListView ItemsSource="{Binding BrowseObjects}" SelectedItem="{Binding SelectedBrowseObject}" MaxHeight="140" Margin="0,0,0,4">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Magnitude" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Magnitude, StringFormat='mag {0:F1}'}" Opacity="0.7" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Button Content="Load" Command="{Binding LoadCommand}" HorizontalAlignment="Left" Padding="10,3" Margin="0,0,0,10" />

                <Separator Margin="0,0,0,10" />

                <!-- Position / rate / elements -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Position" FontWeight="Bold" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding PositionText}" />
                        <TextBlock Text="{Binding RateText}" Margin="0,2,0,0" />
                        <TextBlock Margin="0,2,0,0"><Run Text="Max exposure: " /><Run Text="{Binding MaxExposureText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Magnitude: " /><Run Text="{Binding MagnitudeText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Distance now: " /><Run Text="{Binding DistanceNowText, Mode=OneWay}" /></TextBlock>

                        <TextBlock Text="Offset" FontWeight="Bold" Margin="0,10,0,2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RA (arcsec)" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding OffsetRaArcsec, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="Dec (arcsec)" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="3" Text="{Binding OffsetDecArcsec, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Button Content="Clear Offset" Command="{Binding ResetOffsetCommand}" HorizontalAlignment="Left" Padding="6,1" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Orbital Elements" FontWeight="Bold" Margin="0,0,0,2" />
                        <TextBlock Margin="0,2,0,0"><Run Text="Eccentricity: " /><Run Text="{Binding EccentricityText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Inclination: " /><Run Text="{Binding InclinationText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Arg of Perihelion: " /><Run Text="{Binding ArgPeriText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Node: " /><Run Text="{Binding NodeText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Perihelion Distance: " /><Run Text="{Binding PerihelionDistanceText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Semi-Major Axis: " /><Run Text="{Binding SemiMajorAxisText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="{Binding EpochOrPerihelionLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding EpochOrPerihelionText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Mean Anomaly (now): " /><Run Text="{Binding MeanAnomalyNowText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Eccentric Anomaly (now): " /><Run Text="{Binding EccentricAnomalyNowText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="True Anomaly (now): " /><Run Text="{Binding TrueAnomalyNowText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Action buttons -->
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button Content="Frame" Command="{Binding FrameCommand}" Margin="0,0,4,4" Padding="0,4"
                            ToolTip="Sends the current (offset-adjusted) position to NINA's own Framing Assistant to plan FOV/rotation. Does not set a tracking rate or slew by itself." />
                    <Button Content="Slew and Track" Command="{Binding SlewAndTrackCommand}" Margin="4,0,0,4" Padding="0,4" />
                    <Button Content="Set Tracking Rate" Command="{Binding SetTrackingRateCommand}" Margin="0,0,4,4" Padding="0,4" />
                    <Button Content="Set Guider Shift Rate" Command="{Binding SetGuiderShiftRateCommand}" Margin="4,0,0,4" Padding="0,4" />
                </UniformGrid>

                <Separator Margin="0,6,0,10" />

                <!-- 10-night path -->
                <TextBlock Text="10-Night Path" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                    <StackPanel>
                        <Canvas Width="{Binding PathViewBoxWidth}" Height="{Binding PathViewBoxHeight}">
                            <Polyline Points="{Binding PathPoints}" Stroke="{DynamicResource ButtonForegroundBrush}" StrokeThickness="1.5" />
                            <ItemsControl ItemsSource="{Binding PathMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Day 0 (IsTonight) renders larger and in the app's
                                             selected-accent color so tonight's own position
                                             stands out from the other nine nights. -->
                                        <Ellipse Width="{Binding Size}" Height="{Binding Size}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource ButtonForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTonight}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource ButtonBackgroundSelectedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding PathStartLabel}" HorizontalAlignment="Left" FontSize="10" Opacity="0.7" />
                            <TextBlock Text="{Binding PathEndLabel}" HorizontalAlignment="Right" FontSize="10" Opacity="0.7" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,10,0,10" />

                <!-- Add to Sequence -->
                <TextBlock Text="Add to Sequence" FontWeight="Bold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Filter" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFilterNames}" SelectedItem="{Binding SelectedFilterName}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="Exposure (s)" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Column="3" Text="{Binding ExposureSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="4" Text="Frames" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Column="5" Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="Meridian flip" IsChecked="{Binding MeridianFlip}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <CheckBox Content="Autofocus every" IsChecked="{Binding AutofocusEnabled}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding AutofocusMinutes, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,6,0" />
                    <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
                <Button Content="Add to Sequence" Command="{Binding AddToSequenceCommand}" HorizontalAlignment="Left" Padding="10,3"
                        ToolTip="Adds this target (offset-adjusted centering, Perihelion's own tracking rate, optional guiding, and the exposure loop below) to whatever sequence is currently open in the Advanced Sequencer." />

                <Separator Margin="0,10,0,10" />

                <!-- Quick Track -->
                <TextBlock Text="Quick Track" FontWeight="Bold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="Include guiding" IsChecked="{Binding Guiding}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <CheckBox Content="Auto re-apply every 15 min" IsChecked="{Binding AutoReapply}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Start Quick Track" Command="{Binding StartQuickTrackCommand}" Padding="8,3" Margin="0,0,8,0" />
                    <Button Content="Stop" Command="{Binding StopQuickTrackCommand}" Padding="8,3" />
                </StackPanel>
                <TextBlock Text="{Binding QuickTrackStatusText}" TextWrapping="Wrap" Opacity="0.85" />

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
