<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Perihelion.ViewModels"
                    xmlns:alt="clr-namespace:NINA.WPF.Base.View;assembly=NINA.WPF.Base">

    <!--
      Perihelion's native dockable panel content — an implicit DataTemplate (no x:Key) keyed by
      DataType, the standard WPF mechanism NINA's own imaging-tab dock host uses to resolve a
      ContentPresenter's content for a given IDockableVM instance. Merged into
      Application.Current.Resources.MergedDictionaries from PerihelionPlugin's own constructor,
      the same proven mechanism already used for PerihelionOptionsView.xaml — see that file's
      own comment, and PerihelionPlugin.RegisterWindowsResources, for why.
    -->
    <DataTemplate DataType="{x:Type local:PerihelionDockableVM}">
        <DataTemplate.Resources>
            <!-- One shared Button style for the whole panel, rather than repeating Height/
                 Foreground on every button. BasedOn is required — a bare Style with no BasedOn
                 replaces NINA's own app-wide implicit Button style (StandardButton's whole
                 ControlTemplate, including its teal background/hover states) entirely, rather
                 than adding to it.
                 Horizontal spacing is NOT handled here — a previous attempt set ContentTemplate
                 on this style to wrap Content in a Margin'd TextBlock, which turned out to be
                 just as much a no-op as Padding: StandardButton's own ContentPresenter binds only
                 Content="{TemplateBinding Content}", never ContentTemplate, confirmed from its
                 real source (NINA.WPF.Base/Resources/Styles/Button.xaml). The only binding that
                 actually reaches the button is Content itself — so every button below sets its
                 own actual Content to a "<TextBlock Text=... Margin="14,0" />" element instead of
                 a plain string, giving the Margin something real to attach to.
                 That same nested-TextBlock fix introduced a second real bug: NINA's own global
                 implicit TextBlock style (NINA.WPF.Base/Resources/Styles/TextBlock.xaml,
                 "StandardTextBlock") sets Foreground to PrimaryBrush with a plain (non-triggered)
                 Setter. In WPF's property-value-precedence order, a Style Setter always beats an
                 inherited value, so that Setter wins over whatever Foreground this Button itself
                 has, and every nested TextBlock rendered in PrimaryBrush (a dim/secondary color)
                 no matter what was set here. Confirmed from the same real source file. Fixed by
                 giving each TextBlock below its own explicit Foreground binding straight to its
                 ancestor Button's own Foreground (a local value, the one thing nothing outranks) —
                 not a hardcoded brush key, so it also correctly follows StandardButton's own
                 IsMouseOver/IsPressed template triggers (which set Foreground directly) and its
                 IsEnabled dimming (a separate Opacity trigger, unaffected either way). -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Style>
        </DataTemplate.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- Page title — same idea as Orbitals' own large heading at the top of its
                     panel, deliberately different wording ("Orbital Elements" is specifically
                     Orbitals' own panel name, not a generic label to reuse). -->
                <TextBlock Text="Comet &amp; Asteroid Tracking" FontSize="18" Margin="0,0,0,8" />
                <Separator Margin="0,0,0,10" />

                <!-- Browse (left) / Update Sources (right) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Browse" FontWeight="Bold" Margin="0,0,0,4" />
                        <!-- Real user feedback (2026-09-05): this whole section was far too wide
                             (the outer Grid's left column was "2*"), which stretched Refresh and
                             Search off to the right edge of the panel instead of sitting right
                             next to their own combo box / search box, and left the Update Sources
                             column on the right too narrow for its own "Last Updated" text to fit
                             on one line. Fixed width (400px, matching the ListView's own
                             GridViewColumn widths below: 180+90+130) instead of a stretchy "*"
                             column solves both at once — this section now takes only the room it
                             actually needs, and the freed width goes to Update Sources
                             automatically via the outer Grid's own "*" column.
                             One Grid with two rows (not two separate Grids) for the Refresh and
                             Search rows guarantees their buttons — both fixed Width="90" per the
                             same feedback ("all buttons the same width ... aligned horizontally
                             and vertically") — land at the exact same column, so they visually
                             line up when stacked. -->
                        <Grid Width="400" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding ObjectTypes}" SelectedItem="{Binding SelectedObjectType}" Margin="0,0,6,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" Margin="0,0,6,6" />
                            <Button Grid.Row="0" Grid.Column="2" Command="{Binding RefreshBrowseListCommand}" Margin="0,0,0,6"
                                    ToolTip="Comets and asteroids load automatically when this panel opens (from cache if warm) -- use this to force a fresh pull right now.">
                                <TextBlock Text="Refresh" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding SearchCommand}">
                                <TextBlock Text="Search" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>
                        </Grid>
                        <!-- ListView, not ListBox: NINA's own theme only re-styles ListView/
                             ListViewItem globally, not plain ListBox/ListBoxItem (confirmed from
                             a real resource dump in this app's own log, then from NINA's actual
                             source — NINA.WPF.Base/Resources/Styles/ListView.xaml). That same
                             source is why a plain ItemTemplate rendered nothing at all after the
                             background fix: NINA's global ListViewItem style hardcodes its
                             content as a bare GridViewRowPresenter with no Columns of its own —
                             it only draws anything once ListView.View is an actual GridView,
                             whose GridView.ColumnCollection feeds those columns. A real GridView
                             here (not a custom ItemTemplate) is what NINA's own theme actually
                             expects, and its column cells use the app's normal default TextBlock
                             style automatically, same as any other page text. Width="400" matches
                             the Refresh/Search Grid above it — same reasoning as that Grid's own
                             comment. -->
                        <ListView Width="400" HorizontalAlignment="Left" ItemsSource="{Binding BrowseObjects}" SelectedItem="{Binding SelectedBrowseObject}" MaxHeight="140" Margin="0,0,0,4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Magnitude" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Magnitude, StringFormat='mag {0:F1}'}" Opacity="0.7" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <!-- Comet-only (null, shown via TargetNullValue below, for an
                                         asteroid or a comet COBS has no reports for). Filled in
                                         shortly after the list first renders — see
                                         EnrichObservedMagnitudesAsync in the VM — not blocking the
                                         initial Browse population. -->
                                    <GridViewColumn Header="Observed Mag (COBS)" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ObservedMagnitude, StringFormat='mag {0:F1}', TargetNullValue='--'}"
                                                           Opacity="0.7"
                                                           ToolTip="{Binding ObservedAverageMagnitude, StringFormat='5-obs avg {0:F2}'}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button Command="{Binding LoadCommand}" Width="90" HorizontalAlignment="Left">
                            <TextBlock Text="Load" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                    </StackPanel>

                    <!-- "Update Sources", not "Update Databases" — these are live JSON feeds
                         (MPC's comet-elements file, COBS's observation API), not a database, and
                         the previous wording implied otherwise. Same idea as Orbitals' own
                         per-object-type Update/Last Updated rows (its own real category/count
                         labels, e.g. "Comets (4108)", are the model followed here), and this
                         project's existing PINS-side sync status — explicit, deliberate refresh
                         actions with their own real "when" (CometOrbits.LastSyncedUtc /
                         CometActivity.LastFullRefreshUtc, both disk-persisted — see
                         RefreshLastUpdatedText's own doc comment for how that was verified).
                         This column is now "*" instead of a narrow fixed share, so it picks up
                         all the width freed by the Browse column's own fixed 400px above — real
                         user feedback (2026-09-05) was that "Last Updated: ..." was wrapping onto
                         a second line for lack of room. Both Update buttons share the Browse
                         section's own Width="90" for the same "all buttons the same width" reason. -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Update Sources" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CometsCountText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Width="90" Command="{Binding UpdateCometsCommand}" Margin="0,0,8,0"
                                    ToolTip="Re-fetches the comet-elements feed from MPC now, bypassing its normal 6h cache.">
                                <TextBlock Text="Update" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap">
                                <Run Text="Last Updated: " /><Run Text="{Binding CometsLastUpdatedText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COBS" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Width="90" Command="{Binding UpdateCobsCommand}" Margin="0,0,8,0"
                                    ToolTip="Refreshes real observed brightness from COBS for every comet in the browse list. Takes several seconds to tens of seconds -- a deliberate, explicit action, not something that runs automatically.">
                                <TextBlock Text="Update" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap">
                                <Run Text="Last Updated: " /><Run Text="{Binding CobsLastUpdatedText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,10" />

                <!-- Position / rate / elements -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Position" FontWeight="Bold" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding PositionText}" />
                        <TextBlock Text="{Binding RateText}" Margin="0,2,0,0" />
                        <TextBlock Margin="0,2,0,0"><Run Text="Max exposure: " /><Run Text="{Binding MaxExposureText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Magnitude: " /><Run Text="{Binding MagnitudeText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Observed (COBS): " /><Run Text="{Binding ObservedMagnitudeText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Distance now: " /><Run Text="{Binding DistanceNowText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Orbital Elements" FontWeight="Bold" Margin="0,0,0,2" />
                        <!-- Matches NINA.Joko.Plugin.Orbitals' own two-column elements layout:
                             Epoch and Periapsis are two real, separate quantities (a comet's own
                             perihelion passage time is not a substitute for its reference epoch),
                             shown side by side rather than one-or-the-other. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Margin="0,2,0,0"><Run Text="Epoch: " /><Run Text="{Binding EpochText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Epoch (Julian): " /><Run Text="{Binding EpochJulianText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Perihelion Distance: " /><Run Text="{Binding PerihelionDistanceText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Eccentricity: " /><Run Text="{Binding EccentricityText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Inclination: " /><Run Text="{Binding InclinationText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Arg of Perihelion: " /><Run Text="{Binding ArgPeriText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Node: " /><Run Text="{Binding NodeText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Source: " /><Run Text="{Binding SourceText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,2,0,0"><Run Text="Periapsis: " /><Run Text="{Binding PeriapsisText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Periapsis (Julian): " /><Run Text="{Binding PeriapsisJulianText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Mean Anomaly at Epoch: " /><Run Text="{Binding MeanAnomalyAtEpochText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Semi-Major Axis: " /><Run Text="{Binding SemiMajorAxisText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Mean Anomaly: " /><Run Text="{Binding MeanAnomalyNowText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Eccentric Anomaly: " /><Run Text="{Binding EccentricAnomalyNowText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="True Anomaly: " /><Run Text="{Binding TrueAnomalyNowText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Distance: " /><Run Text="{Binding DistanceNowText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Offset — kept as editable fields (precise manual control is still useful),
                     with a real "Set Offset" capture button alongside them now too: same
                     semantic as NINA.Joko.Plugin.Orbitals' own SetOffset (confirmed from its
                     real source), which takes the mount's actual current position minus the
                     target's true position, so manually framing (slew/plate-solve/center
                     wherever you actually want, e.g. a comet's tail rather than its nucleus)
                     and then capturing that positioning is a real alternative to typing exact
                     values by hand. Read-only, HH:MM:SS/DMS — matches Orbitals' own displayed
                     format for RAOffset/DecOffset exactly, not a raw arcsec number. -->
                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Offset RA" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" Text="{Binding OffsetRaText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="Offset Dec" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="3" Text="{Binding OffsetDecText, Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>

                <!-- Action buttons — same 2x3 arrangement as Orbitals' own panel. Height/
                     Foreground come from the shared Button style in this DataTemplate's own
                     Resources (see the top of this file); each button's own text is a nested
                     TextBlock with a real Margin, not a plain Content string (see that same
                     comment for why). -->
                <UniformGrid Columns="3" Margin="0,4,0,0">
                    <Button Command="{Binding FrameCommand}" Margin="0,0,4,4"
                            ToolTip="Sends the current (offset-adjusted) position to NINA's own Framing Assistant to plan FOV/rotation. Does not set a tracking rate or slew by itself.">
                        <TextBlock Text="Frame" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button Command="{Binding SetTrackingRateCommand}" Margin="4,0,4,4">
                        <TextBlock Text="Set Tracking Rate" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button Command="{Binding SetOffsetFromMountCommand}" Margin="4,0,0,4"
                            ToolTip="Captures the mount's current actual position minus this target's true position as the offset above -- manually frame first, then capture.">
                        <TextBlock Text="Set Offset" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button Command="{Binding SlewAndTrackCommand}" Margin="0,0,4,0">
                        <TextBlock Text="Slew and Track" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button Command="{Binding SetGuiderShiftRateCommand}" Margin="4,0,4,0">
                        <TextBlock Text="Set Guider Shift Rate" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                    <Button Command="{Binding ResetOffsetCommand}" Margin="4,0,0,0">
                        <TextBlock Text="Clear Offset" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                </UniformGrid>

                <Separator Margin="0,6,0,10" />

                <!-- Tonight's altitude / 10-night path -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Tonight's Altitude" FontWeight="Bold" Margin="0,0,0,4" />
                        <!-- NINA's own real AltitudeChart control (proper twilight shading, a
                             real transit/meridian annotation, moon position, "Now" line) — not
                             a hand-rolled chart. Its own DataContext is the target itself
                             (LoadedDso, a real NINA.Astrometry.DeepSkyObject whose Altitudes/
                             Horizon/MaxAltitude compute themselves once SetDateAndPosition is
                             called), separate from NighttimeData which drives the twilight/moon
                             background — exactly the same two-binding pattern NINA's own
                             FramingAssistantView.xaml uses. -->
                        <!-- NighttimeData must be bound via RelativeSource, not a plain
                             {Binding} — DataContext="{Binding LoadedDso}" above overrides the
                             ambient DataContext for this element to the DSO itself, so a plain
                             {Binding NighttimeData} would look for that property on the DSO (and
                             silently fail) rather than on this panel's own VM. Walking back up to
                             the outer ScrollViewer (whose own DataContext is never overridden)
                             is the same workaround NINA's own FramingAssistantView.xaml uses
                             (there via a BindingProxy resource) for this exact situation. -->
                        <alt:AltitudeChart DataContext="{Binding LoadedDso}"
                                           NighttimeData="{Binding DataContext.NighttimeData, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                           MinHeight="180" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="10-Night Path" FontWeight="Bold" Margin="0,0,0,4" />
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                            <StackPanel>
                                <Canvas Width="{Binding PathViewBoxWidth}" Height="{Binding PathViewBoxHeight}">
                                    <!-- Dashed, matching the Touch-N-Stars web panel's own path
                                         chart convention rather than a plain solid line. -->
                                    <Polyline Points="{Binding PathPoints}" Stroke="{DynamicResource ButtonForegroundBrush}" StrokeThickness="1.5" StrokeDashArray="4,3" />
                                    <ItemsControl ItemsSource="{Binding PathMarkers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Day 0 (IsTonight) fills solid in the app's
                                                     selected-accent color; the last night (IsEnd)
                                                     renders as a larger hollow ring instead of a
                                                     filled dot, so the chart reads start-to-end
                                                     at a glance rather than as an undifferentiated
                                                     string of dots. ToolTip is WPF's native
                                                     hover-for-detail equivalent of "click a point
                                                     for info" on a custom vector chart like this
                                                     one — each dot's own date/RA/Dec, not just
                                                     an anonymous marker. -->
                                                <Ellipse Width="{Binding Size}" Height="{Binding Size}" ToolTip="{Binding Tooltip}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource ButtonForegroundBrush}" />
                                                            <Setter Property="Stroke" Value="{x:Null}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTonight}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource ButtonBackgroundSelectedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnd}" Value="True">
                                                                    <Setter Property="Fill" Value="Transparent" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource ButtonForegroundBrush}" />
                                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PathLeftLabel}" HorizontalAlignment="Left" FontSize="10" Opacity="0.7" />
                                    <TextBlock Text="{Binding PathRightLabel}" HorizontalAlignment="Right" FontSize="10" Opacity="0.7" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,10,0,10" />

                <!-- Add to Sequence (left) / Quick Track (right), with a real vertical rule
                     between them — real user feedback (2026-09-05): these two sections needed
                     more room and more even spacing between their own rows, and side by side
                     (rather than stacked, as before) is a reasonable fit specifically because
                     NINA is desktop-only software (unlike the Touch-N-Stars mobile panel), and
                     this same file already uses a two-column layout twice above (Position/
                     Orbital Elements, Tonight's Altitude/10-Night Path) without issue. Each
                     column below stacks its own fields label-above-input (matching the existing
                     Meridian flip/Autofocus convention already used here) rather than the old
                     wide horizontal row of fixed pixel widths, which assumed close to the full
                     panel width and would have overflowed a half-width column on a narrower dock.
                     A Border (not a Separator control — NINA's own Separator style always draws
                     a horizontal line regardless of the element's own orientation) gives the real
                     vertical rule, sized to the row's own height via VerticalAlignment="Stretch"
                     and its own Margin providing the gap either side. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Add to Sequence" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Filter" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableFilterNames}" SelectedItem="{Binding SelectedFilterName}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Exposure (s)" Margin="0,0,0,3" />
                                <TextBox Text="{Binding ExposureSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Frames" Margin="0,0,0,3" />
                                <TextBox Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <!-- NINA's own global CheckBox style is a fixed ON/OFF toggle with no
                             ContentPresenter at all — Content is silently ignored (confirmed from
                             NINA.WPF.Base's own CheckBox.xaml), which is exactly why a real-
                             hardware test showed these with no visible label at all. A separate
                             TextBlock above each toggle is the only way to actually label one. -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Meridian flip" Margin="0,0,0,3" />
                            <CheckBox IsChecked="{Binding MeridianFlip}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Autofocus every" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding AutofocusEnabled}" Margin="0,0,10,0" />
                                <TextBox Text="{Binding AutofocusMinutes, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding AddToSequenceCommand}" HorizontalAlignment="Left"
                                ToolTip="Adds this target (offset-adjusted centering, Perihelion's own tracking rate, optional guiding, and the exposure loop below) to whatever sequence is currently open in the Advanced Sequencer.">
                            <TextBlock Text="Add to Sequence" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="12,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Stretch" />

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Quick Track" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Include guiding" Margin="0,0,0,3" />
                            <CheckBox IsChecked="{Binding Guiding}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Auto re-apply every 15 min" Margin="0,0,0,3" />
                            <CheckBox IsChecked="{Binding AutoReapply}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Command="{Binding StartQuickTrackCommand}" Margin="0,0,8,0">
                                <TextBlock Text="Start Quick Track" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>
                            <Button Command="{Binding StopQuickTrackCommand}">
                                <TextBlock Text="Stop" Margin="14,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding QuickTrackStatusText}" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
