<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Perihelion.ViewModels"
                    xmlns:alt="clr-namespace:NINA.WPF.Base.View;assembly=NINA.WPF.Base"
                    xmlns:conv="clr-namespace:Perihelion.Converters">

    <!--
      Perihelion's native dockable panel content — an implicit DataTemplate (no x:Key) keyed by
      DataType, the standard WPF mechanism NINA's own imaging-tab dock host uses to resolve a
      ContentPresenter's content for a given IDockableVM instance. Merged into
      Application.Current.Resources.MergedDictionaries from PerihelionPlugin's own constructor.
    -->
    <DataTemplate DataType="{x:Type local:PerihelionDockableVM}">
        <DataTemplate.Resources>
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
            <conv:MagnitudeDiffBrushConverter x:Key="MagnitudeDiffBrush" />
            <!-- BasedOn is required — a bare Style with no BasedOn replaces NINA's own implicit
                 Button style entirely rather than extending it. Content is set to a nested
                 TextBlock (not a plain string) since StandardButton's ContentPresenter ignores
                 Padding/ContentTemplate — only Content itself reaches the button. Each nested
                 TextBlock's Foreground is hardcoded to ButtonForegroundBrush rather than bound to
                 the ancestor Button's own Foreground: StandardButton's IsMouseOver trigger sets
                 Background AND Foreground to the same brush on hover, so following the button's
                 Foreground makes the text disappear into its own highlighted background. -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Style>
        </DataTemplate.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <TextBlock Text="Comet &amp; Asteroid Tracking" FontSize="18" Margin="0,0,0,4" />
                <TextBlock Text="Browse and load a comet or asteroid below, then either add it to a sequence for an unattended run, or Quick Track it right now."
                           TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />
                <Separator Margin="0,0,0,10" />

                <!-- Live feeds (MPC comet elements, JPL SBDB, COBS), not a static database. Each
                     source shares the same fixed 130px label column so every source's buttons
                     land in the same position regardless of label width. COBS has no Import/
                     Export/Clear — it's a live per-comet observation cache, not an elements
                     dataset, so those don't apply to it. -->
                <Expander Header="Update Sources" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,8,0,0">

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CometsCountText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Opacity="0.7">
                        <Run Text="Last Updated: " /><Run Text="{Binding CometsLastUpdatedText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Width="70" Margin="0,0,6,0" Command="{Binding UpdateCometsCommand}"
                                ToolTip="Re-fetches the comet-elements feed from MPC now, bypassing its normal 6h cache.">
                            <TextBlock Text="Update" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <Button Width="70" Margin="0,0,6,0" Command="{Binding ImportCometsCommand}"
                                ToolTip="Loads comet elements from a local file already in MPC's own plain CometEls.txt format, replacing the current comet cache entirely.">
                            <TextBlock Text="Import" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <Button Width="70" Margin="0,0,6,0" Command="{Binding ExportCometsCommand}"
                                ToolTip="Saves the currently cached comet elements to a local file in the same plain MPC CometEls.txt format, e.g. to share with another install.">
                            <TextBlock Text="Export" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <Button Width="70" Command="{Binding ClearCometsCommand}"
                                ToolTip="Removes all cached comet elements. The Browse list's comets will be empty until the next Update or a fresh Load.">
                            <TextBlock Text="Clear" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Opacity="0.55" FontSize="10" Margin="0,4,0,0"
                               Text="Import accepts a plain MPC CometEls.txt file (from anyone, not just another Perihelion install) and replaces the current cache; Export saves the current cache the same way; Clear removes it until the next Update." />
                </Grid>

                <!-- Asteroids: live-fetched from JPL SBDB per object, 24h cache (main-belt
                     elements barely move day to day). Import/Export use Perihelion's own plain
                     JSON list, not a third-party format — there's no bulk-file equivalent for
                     this curated, per-object-fetched set the way CometEls.txt covers comets. -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AsteroidsCountText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Opacity="0.7">
                        <Run Text="Last Updated: " /><Run Text="{Binding AsteroidsLastUpdatedText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Width="70" Margin="0,0,6,0" Command="{Binding UpdateAsteroidsCommand}"
                                ToolTip="Re-fetches current orbital elements for every tracked asteroid from JPL's Small-Body Database now, bypassing the normal 24h cache.">
                            <TextBlock Text="Update" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <Button Width="70" Margin="0,0,6,0" Command="{Binding ImportAsteroidsCommand}"
                                ToolTip="Loads asteroid elements from a local Perihelion JSON export, replacing the current asteroid cache entirely.">
                            <TextBlock Text="Import" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <Button Width="70" Margin="0,0,6,0" Command="{Binding ExportAsteroidsCommand}"
                                ToolTip="Saves the currently cached asteroid elements to a local JSON file, e.g. to share with another Perihelion install.">
                            <TextBlock Text="Export" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <Button Width="70" Command="{Binding ClearAsteroidsCommand}"
                                ToolTip="Removes all cached asteroid elements. The Browse list's asteroids will be empty until the next Update or a fresh Load.">
                            <TextBlock Text="Clear" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Opacity="0.55" FontSize="10" Margin="0,4,0,0"
                               Text="Import/Export use Perihelion's own JSON format (share it with another Perihelion install); Clear removes the cache until the next Update." />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CobsCountText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Opacity="0.7">
                        <Run Text="Last Updated: " /><Run Text="{Binding CobsLastUpdatedText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Width="70" Command="{Binding UpdateCobsCommand}"
                                ToolTip="Refreshes observed brightness from COBS for every comet in the browse list. Takes several seconds to tens of seconds -- a deliberate, explicit action, not something that runs automatically.">
                            <TextBlock Text="Update" Margin="6,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding UpdateSourcesStatusText}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,0" />

                </StackPanel>
                </Expander>

                <Separator Margin="0,14,0,10" />

                <TextBlock Text="Browse" FontWeight="Bold" Margin="0,0,0,4" />
                <!-- Middle column fixed width (originally 268px, matching the "Clear" buttons'
                     own start X above; widened to 300px on request to give the status/search
                     text a bit more breathing room before Refresh/Search, since a long status
                     message could otherwise run right up against the button). A "*" column would
                     instead stretch to the panel's full width. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding ObjectTypes}" SelectedItem="{Binding SelectedObjectType}" Margin="0,0,6,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" Margin="0,0,6,6" />
                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding RefreshBrowseListCommand}" Margin="0,0,0,6"
                            ToolTip="Comets and asteroids load automatically when this panel opens (from cache if warm) -- use this to force a fresh pull right now.">
                        <TextBlock Text="Refresh" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding SearchCommand}">
                        <TextBlock Text="Search" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>
                </Grid>
                <!-- ListView, not ListBox: NINA's own theme only re-styles ListView/ListViewItem
                     globally. A GridView (not a custom ItemTemplate) is required too — NINA's
                     global ListViewItem style hardcodes a bare GridViewRowPresenter with no
                     columns of its own, so it only draws content once ListView.View is an actual
                     GridView. Header padding "2,0,0,0" matches each row's own 2px inset (from
                     NINA's ListViewItem Border padding), keeping header/cell text aligned. -->
                <ListView ItemsSource="{Binding BrowseObjects}" SelectedItem="{Binding SelectedBrowseObject}" MaxHeight="140" Margin="0,0,0,12" HorizontalAlignment="Left">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding" Value="2,0,0,0" />
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Magnitude" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Magnitude, StringFormat='mag {0:F1}'}" Opacity="0.7" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Comet-only (null for an asteroid, or a comet COBS has no reports
                                 for). Filled in shortly after the list first renders — see
                                 EnrichObservedMagnitudesAsync in the VM. -->
                            <GridViewColumn Header="Observed Mag (COBS)" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ObservedMagnitude, StringFormat='mag {0:F1}', TargetNullValue='--'}"
                                                   ToolTip="{Binding ObservedAverageMagnitude, StringFormat='5-obs avg {0:F2}'}">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource MagnitudeDiffBrush}">
                                                    <Binding Path="Magnitude" />
                                                    <Binding Path="ObservedMagnitude" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Button Command="{Binding LoadCommand}" Width="90" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <TextBlock Text="Load" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>

                <Separator Margin="0,0,0,10" />

                <!-- Tonight's Altitude / 10-Night Path share one row; each column is its own
                     Auto+"*"-row Grid so the shorter one stretches to match the taller one's
                     height, with no hardcoded height number on either side. The Path column is
                     "Auto" width (sized to its own fixed-260px canvas) rather than "*", so it
                     doesn't stretch with empty space around the actual chart. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Tonight's Altitude" FontWeight="Bold" Margin="0,0,0,4" />
                        <!-- NINA's own AltitudeChart control (twilight shading, transit/meridian
                             annotation, moon position, "Now" line). DataContext is the target
                             itself (LoadedDso); NighttimeData drives the twilight/moon background
                             and must be bound via RelativeSource since DataContext="{Binding
                             LoadedDso}" above overrides the ambient DataContext for this element. -->
                        <alt:AltitudeChart Grid.Row="1" DataContext="{Binding LoadedDso}"
                                           NighttimeData="{Binding DataContext.NighttimeData, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                           MinHeight="180" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="10-Night Path" FontWeight="Bold" Margin="0,0,0,4" />
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                            <StackPanel>
                                <Canvas Width="{Binding PathViewBoxWidth}" Height="{Binding PathViewBoxHeight}">
                                    <!-- Light reference grid, a proportion aid only — not a
                                         labeled coordinate readout. -->
                                    <ItemsControl ItemsSource="{Binding PathGridLines}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Stroke="#334155" StrokeThickness="1" Opacity="0.4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Polyline Points="{Binding PathPoints}" Stroke="#A78BFA" StrokeThickness="1.5" Opacity="0.85" />
                                    <ItemsControl ItemsSource="{Binding PathMarkers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style>
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Day 0 fills solid; the last night renders as a
                                                     hollow ring, so the chart reads start-to-end
                                                     at a glance. -->
                                                <Ellipse Width="{Binding Size}" Height="{Binding Size}" ToolTip="{Binding Tooltip}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#A78BFA" />
                                                            <Setter Property="Stroke" Value="{x:Null}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTonight}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource ButtonBackgroundSelectedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnd}" Value="True">
                                                                    <Setter Property="Fill" Value="Transparent" />
                                                                    <Setter Property="Stroke" Value="#A78BFA" />
                                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Angular scale bar — a length reference, not a coordinate
                                         grid. Tick positions precomputed in the VM. -->
                                    <Line Visibility="{Binding PathScaleBarVisibility}"
                                          X1="{Binding PathScaleBarInfo.X1}" Y1="{Binding PathScaleBarInfo.Y}"
                                          X2="{Binding PathScaleBarInfo.X2}" Y2="{Binding PathScaleBarInfo.Y}"
                                          Stroke="#94A3B8" StrokeThickness="1.5" />
                                    <Line Visibility="{Binding PathScaleBarVisibility}"
                                          X1="{Binding PathScaleBarInfo.X1}" Y1="{Binding PathScaleBarInfo.TickTopY}"
                                          X2="{Binding PathScaleBarInfo.X1}" Y2="{Binding PathScaleBarInfo.TickBottomY}"
                                          Stroke="#94A3B8" StrokeThickness="1.5" />
                                    <Line Visibility="{Binding PathScaleBarVisibility}"
                                          X1="{Binding PathScaleBarInfo.X2}" Y1="{Binding PathScaleBarInfo.TickTopY}"
                                          X2="{Binding PathScaleBarInfo.X2}" Y2="{Binding PathScaleBarInfo.TickBottomY}"
                                          Stroke="#94A3B8" StrokeThickness="1.5" />
                                    <TextBlock Visibility="{Binding PathScaleBarVisibility}"
                                               Canvas.Left="{Binding PathScaleBarInfo.X1}"
                                               Canvas.Top="{Binding PathScaleBarInfo.LabelY}"
                                               Text="{Binding PathScaleBarInfo.Label}" FontSize="9" Foreground="#94A3B8" />
                                </Canvas>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PathLeftLabel}" HorizontalAlignment="Left" FontSize="10" Opacity="0.7" />
                                    <TextBlock Text="{Binding PathRightLabel}" HorizontalAlignment="Right" FontSize="10" Opacity="0.7" />
                                </Grid>
                                <TextBlock Text="{Binding PathDriftSummaryText}" FontSize="10" Opacity="0.6" Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Separator Margin="0,6,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Position" FontWeight="Bold" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding PositionText}" />
                        <TextBlock Text="{Binding RateText}" Margin="0,2,0,0" />
                        <!-- Max exposure is a tracking ceiling only (seconds before 1px drift) —
                             it knows nothing about sky background/light pollution/filter, which
                             is usually the limit on sub length. -->
                        <TextBlock Margin="0,2,0,0"
                                   ToolTip="Tracking limit only -- seconds before the target drifts 1px relative to the background stars. Doesn't account for sky background/light pollution or your filter, which is usually the limit on sub length under a broadband filter at a brighter site.">
                            <Run Text="Max exposure: " /><Run Text="{Binding MaxExposureText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Magnitude: " /><Run Text="{Binding MagnitudeText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Observed (COBS): " /><Run Text="{Binding ObservedMagnitudeMainText, Mode=OneWay}" Foreground="{Binding ObservedMagnitudeMainBrush, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding ObservedMagnitudeAverageText, Mode=OneWay}" Foreground="{Binding ObservedMagnitudeAverageBrush, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="Distance now: " /><Run Text="{Binding DistanceNowText, Mode=OneWay}" /></TextBlock>

                        <!-- Offset — read-only (HH:MM:SS/DMS), set via the Framing Composer
                             (Capture Offset from Mount, or dragging the sky map). Sits at the
                             bottom of this column since Position naturally runs 2 rows shorter
                             than Orbital Elements' own sub-columns. -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Offset RA" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{Binding OffsetRaText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="Offset Dec" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="3" Text="{Binding OffsetDecText, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Orbital Elements" FontWeight="Bold" Margin="0,0,0,2" />
                        <!-- Epoch and Periapsis are two distinct quantities (a comet's own
                             perihelion passage time isn't a substitute for its reference epoch),
                             shown side by side rather than one-or-the-other. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Margin="0,2,0,0"><Run Text="Epoch: " /><Run Text="{Binding EpochText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Epoch (Julian): " /><Run Text="{Binding EpochJulianText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Perihelion Distance: " /><Run Text="{Binding PerihelionDistanceText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Eccentricity: " /><Run Text="{Binding EccentricityText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Inclination: " /><Run Text="{Binding InclinationText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Arg of Perihelion: " /><Run Text="{Binding ArgPeriText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Node: " /><Run Text="{Binding NodeText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Source: " /><Run Text="{Binding SourceText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,2,0,0"><Run Text="Periapsis: " /><Run Text="{Binding PeriapsisText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Periapsis (Julian): " /><Run Text="{Binding PeriapsisJulianText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Mean Anomaly at Epoch: " /><Run Text="{Binding MeanAnomalyAtEpochText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Semi-Major Axis: " /><Run Text="{Binding SemiMajorAxisText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Mean Anomaly: " /><Run Text="{Binding MeanAnomalyNowText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Eccentric Anomaly: " /><Run Text="{Binding EccentricAnomalyNowText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="True Anomaly: " /><Run Text="{Binding TrueAnomalyNowText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0"><Run Text="Distance: " /><Run Text="{Binding DistanceNowText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding EpochStaleWarningText}" TextWrapping="Wrap"
                                   Visibility="{Binding EpochStaleWarningText, Converter={StaticResource NullOrEmptyToVisibility}}"
                                   Foreground="{DynamicResource NotificationWarningBrush}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="3" Margin="0,4,0,0">
                    <Button Command="{Binding FrameCommand}" Margin="0,0,4,0"
                            ToolTip="Opens the Perihelion Framing Composer -- a sky/FOV view, Slew and Center, rotation (if a rotator is connected), and offset capture, carried into Add to Sequence and Quick Track.">
                        <TextBlock Text="Frame" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>
                    <Button Command="{Binding SetTrackingRateCommand}" Margin="4,0,4,0">
                        <TextBlock Text="Set Tracking Rate" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>
                    <Button Command="{Binding ResetOffsetCommand}" Margin="4,0,0,0">
                        <TextBlock Text="Clear Offset" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>
                </UniformGrid>

                <Separator Margin="0,14,0,14" />

                <!-- Shared between Add to Sequence AND Quick Track (both read this same Guiding
                     property), so it sits above the split rather than looking scoped to one. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Include guiding" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding Guiding}" />
                </StackPanel>
                <TextBlock Text="Shifts the guider's lock position at the same rate as the tracking rate, so guiding doesn't fight it, and starts guiding if it isn't already running — needed whenever you're actually guiding, otherwise leave it off."
                           TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,-10,0,16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Add to Sequence" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Builds a sequence step to slew, center, track, and image this target with the Advanced Sequencer -- for a full unattended run." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4" />
                        <!-- Every target added here silently gets a PerihelionReapplyTrigger
                             (not a toggle) — this is what keeps a long unattended run's rate
                             accurate without anyone there to reapply it manually. Same
                             Options-page setting Quick Track's own reapply reads, via the shared
                             ReapplyIntervalSeconds property. -->
                        <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,14">
                            <Run Text="Automatically includes a Reapply Tracking Rate step (not a toggle — always on) that recomputes and resends the rate every " />
                            <Run Text="{Binding ReapplyIntervalSeconds, Mode=OneWay}" />
                            <Run Text=" s during the run -- this is what keeps a long, unattended sequence accurate as the object's true rate drifts." />
                        </TextBlock>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Filter" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableFilterNames}" SelectedItem="{Binding SelectedFilterName}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Exposure (s)" Margin="0,0,0,3" />
                                <TextBox Text="{Binding ExposureSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Frames" Margin="0,0,0,3" />
                                <TextBox Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <!-- NINA's global CheckBox style ignores Content entirely, so the label
                             has to be a separate TextBlock. Rotation comes from the Framing
                             Composer (via the Frame button below), not a typed angle here. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Meridian flip" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox IsChecked="{Binding MeridianFlip}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Autofocus every" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox IsChecked="{Binding AutofocusEnabled}" Margin="0,0,10,0" />
                            <TextBox Text="{Binding AutofocusMinutes, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <Button Command="{Binding AddToSequenceCommand}" HorizontalAlignment="Left"
                                ToolTip="Adds this target (offset-adjusted centering, Perihelion's own tracking rate, optional guiding, and the exposure loop below) to whatever sequence is currently open in the Advanced Sequencer.">
                            <TextBlock Text="Add to Sequence" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="12,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Stretch" />

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Quick Track" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Starts tracking this target right now, independent of any sequence -- for manual framing, visual use, or a target you've already centered." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4" />
                        <!-- Not a toggle — Quick Track never runs inside a sequence, so this
                             meridian-flip stop is a fixed safety behavior, not a preference. -->
                        <TextBlock Text="Automatically stops tracking (not a toggle — always on) if your mount reports it's reached its meridian flip limit." TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <!-- ReapplyIntervalSeconds is the Options-page value (900 by
                                 default), not a converted figure — see that property's own doc
                                 comment. Quick Track is an attended action, so its own reapply
                                 keeps the rate accurate during THIS session, not an unattended one
                                 (that's Add to Sequence's own PerihelionReapplyTrigger instead). -->
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                                <Run Text="Auto re-apply every " /><Run Text="{Binding ReapplyIntervalSeconds, Mode=OneWay}" /><Run Text=" s" />
                            </TextBlock>
                            <CheckBox IsChecked="{Binding AutoReapply}" />
                        </StackPanel>
                        <TextBlock Text="Recomputes and re-sends the rate on a timer as the object's true rate drifts during this session." TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Command="{Binding StartQuickTrackCommand}" Margin="0,0,8,0">
                                <TextBlock Text="Start Quick Track" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                            </Button>
                            <Button Command="{Binding StopQuickTrackCommand}">
                                <TextBlock Text="Stop" Margin="14,0" Foreground="{DynamicResource ButtonForegroundBrush}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding QuickTrackStatusText}" TextWrapping="Wrap" Opacity="0.85" />
                        <TextBlock Text="{Binding QuickTrackElapsedText}"
                                   Visibility="{Binding QuickTrackElapsedText, Converter={StaticResource NullOrEmptyToVisibility}}"
                                   Opacity="0.7" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding QuickTrackAppliedAgoText}"
                                   Visibility="{Binding QuickTrackAppliedAgoText, Converter={StaticResource NullOrEmptyToVisibility}}"
                                   Opacity="0.7" FontSize="11" />
                        <TextBlock Text="{Binding QuickTrackNextReapplyText}"
                                   Visibility="{Binding QuickTrackNextReapplyText, Converter={StaticResource NullOrEmptyToVisibility}}"
                                   Opacity="0.7" FontSize="11" />
                        <TextBlock Text="{Binding QuickTrackLastErrorText}" TextWrapping="Wrap"
                                   Visibility="{Binding QuickTrackLastErrorText, Converter={StaticResource NullOrEmptyToVisibility}}"
                                   Foreground="{DynamicResource NotificationErrorBrush}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding QuickTrackGuidingErrorText}" TextWrapping="Wrap"
                                   Visibility="{Binding QuickTrackGuidingErrorText, Converter={StaticResource NullOrEmptyToVisibility}}"
                                   Foreground="{DynamicResource NotificationWarningBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,14,0,10" />

                <Expander Header="How This Works" IsExpanded="False">
                    <StackPanel Margin="0,10,0,4">
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10">
                            <Run FontWeight="Bold" Text="1. Browse" /><Run Text=" — search or scroll the list (sorted by predicted brightness), then click Load on a comet or asteroid." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10">
                            <Run FontWeight="Bold" Text="2. Loading" /><Run Text=" pulls its live position, tracking rate, and orbital elements, plus tonight's altitude and a 10-night path." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10">
                            <Run FontWeight="Bold" Text="3. Frame / Set Offset" /><Run Text=" (optional) — Frame previews the target in NINA's own Framing Assistant; Set Offset captures a manual centering offset from wherever the mount is actually pointed right now." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Opacity="0.85">
                            <Run FontWeight="Bold" Text="4. Add to Sequence or Quick Track" /><Run Text=" — Add to Sequence builds a step for the Advanced Sequencer, for a full unattended run. Quick Track starts tracking immediately instead, independent of any sequence, for manual framing or visual use." />
                        </TextBlock>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
