<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      DockableVM.ImageGeometry (NINA.WPF.Base) is a filled GeometryGroup, not a stroked icon — it
      defaults to a "PuzzlePieceSVG" resource when a plugin doesn't set one.

      A precise conversion of Lucide's "orbit" icon (https://lucide.dev, ISC License — verified
      against lucide-icons/lucide's own LICENSE file) — two circular arcs plus three circles,
      converted from Lucide's stroked SVG source to filled paths via Inkscape's own
      "object-stroke-to-path" operation, then carried into WPF's Path markup syntax essentially
      verbatim (WPF and SVG path mini-languages accept the same command letters). FillRule is
      Nonzero, not EvenOdd — Inkscape's own output for each circle is two subpaths with opposite
      winding to produce the ring hole, which needs winding-based fill to render correctly.
    -->
    <GeometryGroup x:Key="PerihelionOrbitSVG" FillRule="Nonzero">
        <!-- Outer arc (top-right sweep) -->
        <PathGeometry Figures="m 19.789062,5.6503906 a 1,1 0 0 0 -0.28125,1.3847656 c 2.202622,3.3292778 1.865054,7.0856718 0.01953,9.9003908 -1.845523,2.814719 -5.156488,4.622295 -9.087891,3.929687 a 1,1 0 0 0 -1.158203,0.810547 1,1 0 0 0 0.810547,1.158203 c 4.717088,0.831025 8.866209,-1.382569 11.107422,-4.800781 2.241213,-3.418212 2.619375,-8.1069325 -0.02344,-12.1015624 a 1,1 0 0 0 -1.386719,-0.28125 z" />
        <!-- Outer arc (bottom-left sweep) -->
        <PathGeometry Figures="M 10.503906,1.0839844 C 7.2410656,1.5149637 4.4847756,3.4013202 2.8027344,5.9648437 0.56001281,9.3828751 0.18134091,14.072521 2.8242188,18.068359 a 1,1 0 0 0 1.3867187,0.28125 1,1 0 0 0 0.28125,-1.384765 C 2.2894862,13.634521 2.6278362,9.8770841 4.4746094,7.0625 6.3213825,4.2479159 9.6344746,2.4418379 13.566406,3.1367188 A 1,1 0 0 0 14.724609,2.3261719 1,1 0 0 0 13.914063,1.1679687 C 12.734645,0.95953319 11.59152,0.9403246 10.503906,1.0839844 Z" />
        <!-- Nucleus ring (center, r=3) -->
        <PathGeometry Figures="m 12,8 c -2.1972944,0 -4,1.8027056 -4,4 0,2.197294 1.8027056,4 4,4 2.197294,0 4,-1.802706 4,-4 0,-2.1972944 -1.802706,-4 -4,-4 z m 0,2 c 1.116414,0 2,0.883586 2,2 0,1.116414 -0.883586,2 -2,2 -1.116414,0 -2,-0.883586 -2,-2 0,-1.116414 0.883586,-2 2,-2 z" />
        <!-- Top-right small ring (r=2) -->
        <PathGeometry Figures="m 19,2 c -1.64501,0 -3,1.3549904 -3,3 0,1.6450096 1.35499,3 3,3 1.64501,0 3,-1.3549904 3,-3 0,-1.6450096 -1.35499,-3 -3,-3 z m 0,2 c 0.564129,0 1,0.4358706 1,1 0,0.5641294 -0.435871,1 -1,1 -0.564129,0 -1,-0.4358706 -1,-1 0,-0.5641294 0.435871,-1 1,-1 z" />
        <!-- Bottom-left small ring (r=2) -->
        <PathGeometry Figures="m 5,16 c -1.6450096,0 -3,1.35499 -3,3 0,1.64501 1.3549904,3 3,3 1.6450096,0 3,-1.35499 3,-3 0,-1.64501 -1.3549904,-3 -3,-3 z m 0,2 c 0.5641294,0 1,0.435871 1,1 0,0.564129 -0.4358706,1 -1,1 -0.5641294,0 -1,-0.435871 -1,-1 0,-0.564129 0.4358706,-1 1,-1 z" />
    </GeometryGroup>
</ResourceDictionary>
